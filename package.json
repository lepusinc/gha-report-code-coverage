    "glob": "^13.0.6",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.18",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.8.3"
  }
