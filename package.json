{
  "name": "gha-report-code-coverage",
  "version": "1.0.0",
  "description": "GitHub Action to report code coverage from Clover XML artifacts",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
