{
  "name": "gha-report-code-coverage",
  "version": "1.0.0",
  "description": "GitHub Action to report code coverage from Clover XML artifacts",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^2.3.2",
    "@actions/core": "^1.11.1",
    "fast-xml-parser": "^5.2.3",
    "glob": "^13.0.6",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.2.5"
  },
  "overrides": {
    "undici": "^6.25.0",
    "@octokit/plugin-paginate-rest": "^9.2.2",
    "@octokit/request": "^9.2.1",
    "@octokit/request-error": "^6.1.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.18",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
